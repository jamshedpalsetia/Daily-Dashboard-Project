# Copy to .env and fill in. Only the SMTP block is required — every data
# provider the dashboard uses is keyless.

# ---- Database ----
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dashboard

# ---- Email (daily digest) ----
# Gmail: use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_STARTTLS=true

# ---- App ----
# Used for the "open the dashboard" link inside the email.
DASHBOARD_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TZ=America/Los_Angeles
